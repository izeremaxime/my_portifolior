# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Optional: only needed if you wire up real email delivery for the contact form.
# Currently the contact form logs validated submissions server-side; no outbound
# email is sent until these are configured and controllers/contactController.js
# is updated to use them.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=
