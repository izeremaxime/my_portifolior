<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="grid-bg" aria-hidden="true"></div>
  <main class="not-found">
    <p class="brand-mark not-found-mark"><span class="brand-bracket">&lt;</span><span class="brand-letter">404</span><span class="brand-slash">/</span><span class="brand-bracket">&gt;</span></p>
    <h1 class="not-found-title">Page not found.</h1>
    <p class="not-found-text">This route doesn't exist. Let's get you back home.</p>
    <a href="/" class="btn btn-primary">Back to home</a>
  </main>
</body>
</html>
