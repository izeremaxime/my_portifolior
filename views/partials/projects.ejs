<section class="section projects" id="projects">
  <div class="container section-inner">
    <div class="section-head">
      <span class="eyebrow">Featured Work</span>
      <h2 class="section-title">Products → Systems →<br /><span class="accent">Business insight.</span></h2>
      <p class="section-sub">A closer look at the projects I've put the most work into.</p>
    </div>

    <div class="project-grid">
      <article class="project-card project-card--flagship" data-reveal>
        <div class="project-card-visual project-card-visual--grite" aria-hidden="true">
          <div class="mock-window">
            <div class="mock-window-bar">
              <span class="term-dot term-dot--red"></span><span class="term-dot term-dot--yellow"></span><span class="term-dot term-dot--green"></span>
            </div>
            <div class="mock-dashboard">
              <div class="mock-sidebar">
                <span class="mock-pill mock-pill--active"></span>
                <span class="mock-pill"></span>
                <span class="mock-pill"></span>
                <span class="mock-pill"></span>
              </div>
              <div class="mock-main">
                <div class="mock-cards-row">
                  <span class="mock-stat-card"></span>
                  <span class="mock-stat-card"></span>
                  <span class="mock-stat-card"></span>
                </div>
                <div class="mock-table">
                  <span class="mock-table-row"></span>
                  <span class="mock-table-row"></span>
                  <span class="mock-table-row"></span>
                  <span class="mock-table-row"></span>
                </div>
                <div class="mock-chart">
                  <span style="--h:40%"></span><span style="--h:65%"></span><span style="--h:35%"></span>
                  <span style="--h:80%"></span><span style="--h:55%"></span><span style="--h:70%"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="project-card-body">
          <span class="badge">Business System</span>
          <h3 class="project-card-title">Grite SMS</h3>
          <p class="project-card-tagline">Stock Management System</p>
          <p class="project-card-desc">
            A stock management system focused on organizing and managing
            inventory-related operations — products, inventory, management and
            business insight, brought together in one interface.
          </p>
          <div class="project-flow" aria-hidden="true">
            <span>Products</span><span class="flow-arrow">→</span><span>Inventory</span><span class="flow-arrow">→</span><span>Management</span><span class="flow-arrow">→</span><span>Business Insight</span>
          </div>
          <button type="button" class="btn btn-primary" data-modal-open="modal-grite" data-magnetic>
            Explore Project
          </button>
        </div>
      </article>
      <article class="project-card project-card--flagship" data-reveal>
        <div class="project-card-visual project-card-visual--touchtech" aria-hidden="true">
          <div class="mock-window">
            <div class="mock-window-bar">
              <span class="term-dot term-dot--red"></span><span class="term-dot term-dot--yellow"></span><span class="term-dot term-dot--green"></span>
            </div>
            <div class="mock-store">
              <div class="mock-store-search"></div>
              <div class="mock-store-grid">
                <span class="mock-product-card"></span>
                <span class="mock-product-card"></span>
                <span class="mock-product-card"></span>
                <span class="mock-product-card"></span>
              </div>
              <div class="mock-store-cta"></div>
            </div>
          </div>
        </div>
        <div class="project-card-body">
          <span class="badge">E-Commerce</span>
          <h3 class="project-card-title">TouchTech Hub</h3>
          <p class="project-card-tagline">E-Commerce Website</p>
          <p class="project-card-desc">
            A responsive e-commerce interface designed to make product
            discovery and purchasing simple — products, shopping experience
            and product discovery working together.
          </p>
          <div class="project-flow" aria-hidden="true">
            <span>Products</span><span class="flow-arrow">→</span><span>Shopping Experience</span><span class="flow-arrow">→</span><span>Product Discovery</span>
          </div>
          <button type="button" class="btn btn-primary" data-modal-open="modal-touchtech" data-magnetic>
            Explore Project
          </button>
        </div>
      </article>
    </div>

    <div class="project-grid project-grid--secondary">
      <article class="project-card" data-reveal>
        <div class="project-card-visual project-card-visual--quiz" aria-hidden="true">
          <div class="mock-window mock-window--sm">
            <div class="mock-window-bar">
              <span class="term-dot term-dot--red"></span><span class="term-dot term-dot--yellow"></span><span class="term-dot term-dot--green"></span>
            </div>
            <div class="mock-quiz">
              <span class="mock-quiz-question" id="quiz-mock-question">Which language runs in the browser?</span>
              <span class="mock-quiz-option"></span>
              <span class="mock-quiz-option mock-quiz-option--correct"></span>
              <span class="mock-quiz-option"></span>
              <span class="mock-quiz-timer"></span>
            </div>
          </div>
        </div>
        <div class="project-card-body">
          <span class="badge">Web App</span>
          <h3 class="project-card-title">ZUM Quiz</h3>
          <p class="project-card-tagline">Interactive Web Application</p>
          <p class="project-card-desc">
            A configurable quiz app with categories, difficulty levels, a
            timer and result history, powered by the Open Trivia Database API.
          </p>
          <button type="button" class="btn btn-ghost btn-sm" data-modal-open="modal-zum" data-magnetic>
            Explore Project
          </button>
        </div>
      </article>
      <article class="project-card project-card--concept" data-reveal>
        <div class="project-card-visual project-card-visual--trendspark" aria-hidden="true">
          <div class="mock-window mock-window--sm">
            <div class="mock-window-bar">
              <span class="term-dot term-dot--red"></span><span class="term-dot term-dot--yellow"></span><span class="term-dot term-dot--green"></span>
            </div>
            <div class="mock-concept">
              <span class="mock-concept-pulse"></span>
              <span class="mock-concept-label">CONCEPT</span>
            </div>
          </div>
        </div>
        <div class="project-card-body">
          <span class="badge badge--concept">Concept / Pending</span>
          <h3 class="project-card-title">TrendSpark AI</h3>
          <p class="project-card-tagline">AI Marketing Concept</p>
          <p class="project-card-desc">
            An in-progress concept exploring how AI could help surface trends
            and assist with marketing content generation for small businesses.
          </p>
          <button type="button" class="btn btn-ghost btn-sm" data-modal-open="modal-trendspark" data-magnetic>
            Explore Concept
          </button>
        </div>
      </article>
    </div>
  </div>
</section>
